{
    // =========================================================================
    // Zenith IDE Aesthetic: Pure OLED Black, Informative & Stylish
    // =========================================================================
    "workbench.colorTheme": "Tokyo Night",
    "workbench.iconTheme": "material-icon-theme",

    // True Pitch-Black OLED Theme Overrides (Matches Desktop Wallpaper 1:1)
    "workbench.colorCustomizations": {
        "editor.background": "#000000",
        "sideBar.background": "#000000",
        "sideBar.border": "#121218",
        "sideBarSectionHeader.background": "#000000",
        "sideBarSectionHeader.border": "#121218",
        "activityBar.background": "#000000",
        "activityBar.border": "#121218",
        "activityBar.activeBorder": "#E11D48",
        "statusBar.background": "#000000",
        "statusBar.border": "#121218",
        "statusBar.foreground": "#A0A0B0",
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#EAEAEA",
        "titleBar.border": "#121218",
        "panel.background": "#000000",
        "panel.border": "#121218",
        "terminal.background": "#000000",
        "tab.activeBackground": "#000000",
        "tab.activeBorderTop": "#E11D48",
        "tab.inactiveBackground": "#050508",
        "tab.border": "#121218",
        "editorGroupHeader.tabsBackground": "#000000",
        "editorGroupHeader.tabsBorder": "#121218",
        "editorLineNumber.activeForeground": "#E11D48",
        "editorLineNumber.foreground": "#3A3A4A",
        "editor.lineHighlightBackground": "#08090E",
        "editorGutter.background": "#000000",
        "breadcrumb.background": "#000000"
    },

    // Zenith Cyber-Contrast Text & Syntax Coloring
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": ["text", "source"],
                "settings": {
                    "foreground": "#F0F0F5"
                }
            },
            {
                "scope": ["comment", "punctuation.definition.comment"],
                "settings": {
                    "foreground": "#5C5F77",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "keyword",
                    "keyword.control",
                    "storage",
                    "storage.type"
                ],
                "settings": {
                    "foreground": "#E11D48",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "string",
                    "string.quoted",
                    "string.template",
                    "punctuation.definition.string"
                ],
                "settings": {
                    "foreground": "#10B981"
                }
            },
            {
                "scope": [
                    "entity.name.function",
                    "support.function",
                    "meta.function-call"
                ],
                "settings": {
                    "foreground": "#F59E0B"
                }
            },
            {
                "scope": [
                    "variable",
                    "variable.other",
                    "variable.parameter",
                    "entity.name.variable"
                ],
                "settings": {
                    "foreground": "#38BDF8"
                }
            },
            {
                "scope": [
                    "entity.name.type",
                    "entity.name.class",
                    "support.class",
                    "support.type"
                ],
                "settings": {
                    "foreground": "#A855F7"
                }
            },
            {
                "scope": [
                    "constant.numeric",
                    "constant.language",
                    "constant.other"
                ],
                "settings": {
                    "foreground": "#FB7185"
                }
            },
            {
                "scope": [
                    "entity.name.tag",
                    "meta.tag.sgml",
                    "markup.heading"
                ],
                "settings": {
                    "foreground": "#38BDF8",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "entity.other.attribute-name",
                    "entity.other.attribute-name.class",
                    "entity.other.attribute-name.id"
                ],
                "settings": {
                    "foreground": "#F59E0B"
                }
            },
            {
                "scope": ["markup.bold"],
                "settings": {
                    "fontStyle": "bold",
                    "foreground": "#FFFFFF"
                }
            },
            {
                "scope": ["markup.italic"],
                "settings": {
                    "fontStyle": "italic",
                    "foreground": "#F0F0F5"
                }
            },
            {
                "scope": ["markup.inline.raw", "markup.raw.block"],
                "settings": {
                    "foreground": "#10B981"
                }
            }
        ]
    },

    // Typography & Ligatures (Fira Code)
    "editor.fontFamily": "'Fira Code', 'Ubuntu Sans Mono', monospace",
    "editor.fontSize": 13.5,
    "editor.lineHeight": 1.6,
    "editor.fontLigatures": true,
    "editor.letterSpacing": 0.3,

    // Fluid Motion & Animations
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "smooth",
    "editor.cursorStyle": "line",
    "editor.cursorWidth": 2,
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,

    // Screen Focus & Clean Layout
    "editor.minimap.enabled": false,
    "workbench.tree.indent": 18,
    "workbench.tree.renderIndentGuides": "always",
    "editor.renderLineHighlight": "line",

    // Bracket & Scope Guides
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.guides.indentation": true,

    // Auto-Formatting & Code Cleanliness
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.autoSave": "afterDelay",

    // Integrated Terminal Tuning
    "terminal.integrated.fontFamily": "'Fira Code', 'Ubuntu Sans Mono', monospace",
    "terminal.integrated.fontSize": 12.5,
    "terminal.integrated.lineHeight": 1.3,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",

    // GitLens Performance & Clean Status
    "gitlens.currentLine.enabled": false,
    "gitlens.codeLens.enabled": false,
    "gitlens.statusBar.enabled": true,

    // Explorer & File Handling
    "explorer.confirmPasteNative": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.sortOrder": "foldersNfirst",
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js, ${capture}.d.ts.map, ${capture}.min.js, ${capture}.d.ts",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
        "composer.json": "composer.lock",
        ".env": ".env.*, .env.example",
        "artisan": ".env*",
        "vite.config.*": "postcss.config.*, tailwind.config.*",
        "docker-compose.yml": "docker-compose.*, Dockerfile*"
    },
    "javascript.updateImportsOnFileMove.enabled": "always",
    "typescript.updateImportsOnFileMove.enabled": "always",

    // Markdown & CSV Enhancements
    "markdown-preview-enhanced.theme": "atom-dark.css",
    "markdown-preview-enhanced.previewTheme": "atom-dark.css",

    // PHP & Language Tooling
    "php.suggest.basic": false,
    "php.validate.enable": false,
    "[blade]": {
        "editor.defaultFormatter": "shufo.vscode-blade-formatter"
    },
    "emmet.excludeLanguages": [
        "markdown",
        "php"
    ],
    "python.languageServer": "Default"
}