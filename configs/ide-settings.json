{
    // =========================================================================
    // Zenith IDE Aesthetic: Dark, Informative & Stylish
    // =========================================================================
    "workbench.colorTheme": "Tokyo Night",
    "workbench.iconTheme": "material-icon-theme",

    // Typography & Ligatures (Fira Code)
    "editor.fontFamily": "'Fira Code', 'Ubuntu Sans Mono', monospace",
    "editor.fontSize": 13.5,
    "editor.lineHeight": 1.6,
    "editor.fontLigatures": true,
    "editor.letterSpacing": 0.3,

    // Fluid Motion & Animations
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "smooth",
    "editor.cursorStyle": "line",
    "editor.cursorWidth": 2,
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,

    // Screen Focus & Clean Layout
    "editor.minimap.enabled": false,
    "workbench.tree.indent": 18,
    "workbench.tree.renderIndentGuides": "always",
    "editor.renderLineHighlight": "line",

    // Bracket & Scope Guides
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.guides.indentation": true,

    // Auto-Formatting & Code Cleanliness
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.autoSave": "afterDelay",

    // Integrated Terminal Tuning
    "terminal.integrated.fontFamily": "'Fira Code', 'Ubuntu Sans Mono', monospace",
    "terminal.integrated.fontSize": 12.5,
    "terminal.integrated.lineHeight": 1.3,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",

    // GitLens Performance & Clean Status
    "gitlens.currentLine.enabled": false,
    "gitlens.codeLens.enabled": false,
    "gitlens.statusBar.enabled": true,

    // Explorer & File Handling
    "explorer.confirmPasteNative": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "typescript.updateImportsOnFileMove.enabled": "always",

    // PHP & Language Tooling
    "php.suggest.basic": false,
    "php.validate.enable": false,
    "emmet.excludeLanguages": [
        "markdown",
        "php"
    ],
    "python.languageServer": "Default"
}